, "先頭(선두)=맨 앞", "頭腦(두뇌)=머리, 생각하는 힘"], "登": ["癶(두 발)+豆(제기): 제기를 들고 '오르다'", "登山(등산)=산에 오름", "登校(등교)=학교에 감", "登場(등장)=무대에 나옴"], "等": ["竹(대)+寺(음): 대쪽을 가지런히 하여 '같다, 등급'", "同等(동등)=등급이 같음", "平等(평등)=차별 없이 고름", "等級(등급)=높낮이의 차례"], "樂": ["나무 위에 북과 실이 걸린 악기 모양, '즐겁다·음악'", "音樂(음악)=소리의 예술", "樂器(악기)=음악을 연주하는 기구", "樂園(낙원)=즐겁고 편한 곳"], "來": ["보리 이삭 모양에서 '오다'", "未來(미래)=앞으로 올 때", "來日(내일)=다음 날", "外來(외래)=밖에서 들어옴"], "力": ["팔의 근육을 구부린 모양, '힘'", "力道(역도)=무거운 것을 드는 운동", "勢力(세력)=힘의 크기", "能力(능력)=일을 해내는 힘"], "例": ["亻(사람)+列(음): 사람이 늘어놓은 '보기, 법식'", "例外(예외)=보통의 규칙에서 벗어남", "事例(사례)=어떤 일의 보기", "前例(전례)=앞서의 예"], "禮": ["示(제단)+豊(제기): 제사를 올리는 '예도'", "禮節(예절)=예의와 절도", "禮物(예물)=예를 차려 주는 물건", "目禮(목례)=눈으로 하는 인사"], "老": ["머리가 긴 노인이 지팡이 짚은 모습", "老人(노인)=늙은 사람", "老後(노후)=늙은 뒤", "敬老(경로)=노인을 공경함"], "路": ["足(발)+各(음): 발로 다니는 '길'", "道路(도로)=길", "線路(선로)=열차가 다니는 길", "大路(대로)=큰 길"], "綠": ["糸(실)+彔(음): 실의 빛깔 '푸르다'", "草綠(초록)=풀빛", "綠色(녹색)=풀빛 같은 색", "新綠(신록)=새로 돋은 푸른 잎"], "六": ["지붕이 있는 작은 집 모양에서 빌려 쓴 글자라는 설, 숫자 '여섯'", "六月(유월)=6월", "六日(육일)=엿새", "五六(오륙)=대략 5, 6"], "里": ["田(밭)+土(땅): 사람이 사는 '마을'", "洞里(동리)=마을", "千里(천리)=먼 거리", "里長(이장)=마을 우두머리"], "利": ["禾(벼)+刀(칼): 벼를 베는 날카로운 칼, '이롭다'", "利用(이용)=쓸모 있게 씀", "便利(편리)=편하고 이로움", "利子(이자)=빌린 돈에 붙는 값"], "理": ["王(옥)+里(음): 옥의 결을 다스림, '다스리다'", "道理(도리)=마땅한 이치", "理由(이유)=까닭", "地理(지리)=땅의 모양"], "李": ["木(나무)+子(음): 오얏나무, 성(姓)으로 쓰임", "李氏(이씨)=이 가문", "李花(이화)=자두꽃", "行李(행리)=여행 짐"], "林": ["木(나무) 두 개: 나무가 많은 '수풀'", "山林(산림)=산과 숲", "森林(삼림)=나무가 우거진 곳", "密林(밀림)=빽빽한 숲"], "立": ["사람이 땅 위에 서 있는 모양, '서다'", "立春(입춘)=봄이 시작되는 날", "獨立(독립)=스스로 섬", "國立(국립)=나라가 세움"], "萬": ["전갈의 모양에서 많은 수를 뜻하게 됨, '일만'", "萬歲(만세)=오래 살기를 빎", "萬一(만일)=혹시", "萬事(만사)=모든 일"], "每": ["屮(풀)+母(어미): 풀이 어미처럼 계속 자라 '매양'", "每日(매일)=날마다", "每年(매년)=해마다", "每番(매번)=번번이"], "面": ["사람 얼굴의 윤곽을 본뜬 글자, '낯'", "方面(방면)=어떤 쪽", "表面(표면)=겉", "面接(면접)=직접 만나 봄"], "名": ["夕(저녁)+口(입): 어두워 얼굴이 안 보여 이름을 부름, '이름'", "名人(명인)=그 분야에 뛰어난 사람", "有名(유명)=이름이 널리 알려짐", "名物(명물)=이름난 물건"], "命": ["令(명령)+口(입): 입으로 내리는 명령, '목숨'", "生命(생명)=목숨", "命令(명령)=시킴", "運命(운명)=정해진 앞길"], "明": ["日(해)+月(달): 해와 달이 함께 '밝다'", "發明(발명)